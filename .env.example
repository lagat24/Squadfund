# Copy to .env (never commit it). Everything below is a placeholder.

# PostgreSQL connection string from your database host (Render, Neon, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

# Long random string used to sign session cookies
SECRET_KEY=replace-with-a-long-random-string

# Set to production when deployed (turns on Secure cookies)
APP_ENV=development

# PayPal Sandbox REST app credentials: developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-secret

# AI provider (Anthropic). Without a key the app uses clearly labelled rule-based drafts.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5-5

# Seeds the example group "Study Squad Laptops" (invite code DEMO-SQUAD) when none exists
SEED_DEMO_DATA=true
